{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "runobi",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  // `nodejs_compat` is not optional here: the Postgres driver opens a TCP
  // socket, and the Daytona SDK is written for Node.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": { "enabled": true },
  // The builder answers on its own domain; previews are a separate Worker
  // (workers/preview-proxy) on a wildcard of their own.
  // "routes": [{ "pattern": "builder.example.com", "custom_domain": true }],
  // No `vars` block on purpose. Deploying replaces the Worker's plaintext
  // variables with whatever this file lists, so an empty value here would blank
  // the real one set in the dashboard. Encrypted secrets are left alone by a
  // deploy, which is the other reason every value this app needs —
  // DATABASE_URL, DAYTONA_API_KEY, OPENROUTER_API_KEY, APP_HOSTS,
  // PREVIEW_PROXY_DOMAIN, and publishing's SITES_DOMAIN, CF_ACCOUNT_ID,
  // CF_API_TOKEN, CF_KV_NAMESPACE_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY —
  // belongs there as a Secret rather than a Variable.
}
