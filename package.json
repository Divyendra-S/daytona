{
  "name": "ai-builder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "next lint",
    "cf:build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:push": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs push",
    "db:import": "node --env-file=.env.local scripts/import-json-projects.mjs",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write ."
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-tailwindcss"
    ],
    "tailwindStylesheet": "app/globals.css"
  },
  "dependencies": {
    "@ai-sdk/react": "3.0.286",
    "@assistant-ui/react": "0.12.12",
    "@assistant-ui/react-ai-sdk": "1.3.9",
    "@assistant-ui/react-markdown": "0.12.5",
    "@daytonaio/sdk": "0.214.0",
    "@opennextjs/cloudflare": "^1.20.6",
    "@openrouter/ai-sdk-provider": "2.10.0",
    "@radix-ui/react-avatar": "1.1.11",
    "@radix-ui/react-collapsible": "1.1.12",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-tooltip": "1.2.8",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "ai": "6.0.100",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "^0.45.2",
    "fzstd": "^0.1.1",
    "kiwi-schema": "^0.5.0",
    "lucide-react": "0.563.0",
    "next": "16.1.5",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remark-gfm": "4.0.1",
    "shadow-plugin": "^2.1.0",
    "tailwind-merge": "3.5.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5",
    "zustand": "5.0.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.4",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "25.3.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.3",
    "eslint-config-next": "16.1.5",
    "prettier": "3.8.1",
    "prettier-plugin-tailwindcss": "0.7.2",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "wrangler": "^4.132.0"
  },
  "pnpm": {
    "overrides": {
      "@assistant-ui/core": "0.1.1",
      "@assistant-ui/store": "0.2.1",
      "@assistant-ui/tap": "0.5.1"
    },
    "onlyBuiltDependencies": []
  },
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e"
