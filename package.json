  "devDependencies": {
    "@eslint/eslintrc": "3.3.4",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "25.3.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.3",
    "eslint-config-next": "16.1.5",
    "prettier": "3.8.1",
    "prettier-plugin-tailwindcss": "0.7.2",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
